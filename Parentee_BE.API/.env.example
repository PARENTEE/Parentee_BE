# Logging
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT__ASPNETCORE=Warning

# JWT
JWT__KEY=YourSecureJwtKeyAtLeast32Chars
JWT__VALIDISSUERS=http://localhost:5000
JWT__VALIDAUDIENCES=http://localhost:5000
JWT__TOKENEXPIREINHOURS=24
JWT__REFRESHTOKENEXPIREINDAYS=7

# Google OAuth
GOOGLE__CLIENTID=your-google-client-id
GOOGLE__CLIENTSECRET=your-google-client-secret

# Connection Strings
CONNECTIONSTRINGS__POSTGRESCONNECTIONSTRING=Host=localhost;Port=5432;Database=PARENTEE_DB;Username=postgres;Password=yourpassword

# Allowed Hosts
ALLOWEDHOSTS=*

# SMTP Settings
SMTPSETTINGS__HOST=smtp.gmail.com
SMTPSETTINGS__PORT=587
SMTPSETTINGS__USESSL=true
SMTPSETTINGS__USERNAME=your-smtp-username
SMTPSETTINGS__PASSWORD=your-smtp-password
SMTPSETTINGS__FROMADDRESS=your@email.com
SMTPSETTINGS__FROMNAME=PARENTEE

# AI
AI__LLMMODEL=gemini-2.0-flash
AI__LLMAPIKEY=your-llm-api-key
AI__EMBEDDINGMODEL=gemini-embedding-001
AI__EMBEDDINGAPIKEY=your-embedding-api-key
AI__QDRANTHOST=your-qdrant-api-host
AI__QDRANTAPIKEY=your-qdrant-api-key

# PayOS
CLIENT__ID=1a3cae3d-0de2-4e17-b9f1-20d1b2407b33
API__KEY=3f84f297-d058-4f96-b8ed-234a7388acbc
CHECK__SUM__KEY=9ea0817d37a727ae414dd5016e94cc24ec8e784bfa154bbc8176f025fc4935ce
